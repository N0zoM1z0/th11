#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ntlm_root=${TH11_NTLM_ROOT:-$repo_root/.tools/winbind}
ntlm_binary="$ntlm_root/usr/bin/ntlm_auth"
if [[ ! -x "$ntlm_binary" ]]; then
  echo "missing private ntlm_auth prerequisite: $ntlm_binary" >&2
  exit 1
fi
ntlm_lib="$ntlm_root/usr/lib/x86_64-linux-gnu"
exec env LD_LIBRARY_PATH="$ntlm_lib:$ntlm_lib/samba" \
  "$ntlm_binary" "$@"
